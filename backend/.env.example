# RescuePay-AI — Backend Environment Configuration Example
# Duplicate this file as .env in the backend directory:
# Windows (PowerShell): Copy-Item .env.example .env
# Linux/macOS: cp .env.example .env
#
# Never commit .env. It is gitignored.

# Application Configuration
APP_NAME=RescuePay-AI
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# PayPal Configuration (Sandbox for initial development)
# Create a sandbox app at https://developer.paypal.com -> Apps & Credentials (Sandbox).
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_TIMEOUT_SECONDS=15

# Where PayPal sends the buyer back after approving / cancelling checkout.
# These point at the frontend; the frontend then calls the backend to verify.
PAYPAL_RETURN_URL=http://localhost:5173/payment/return
PAYPAL_CANCEL_URL=http://localhost:5173/payment/cancel

# Payment business rules enforced by the backend (comma-separated ISO 4217 codes)
PAYMENT_ALLOWED_CURRENCIES=USD
PAYMENT_MAX_AMOUNT=10000.00
