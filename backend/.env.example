# RescuePay-AI — Backend Environment Configuration Example
# Duplicate this file as .env in the backend directory:
# Copy only when .env does not exist; never overwrite existing private configuration.
# Full setup: ../docs/sandbox-checkout.md
# Windows (PowerShell): if (!(Test-Path .env)) { Copy-Item .env.example .env }
# Linux/macOS: cp .env.example .env
#
# Never commit .env. It is gitignored.

# Application Configuration
APP_NAME=RescuePay-AI
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# PayPal Configuration (Sandbox exclusively; other modes/API targets are rejected)
# Create a sandbox app at https://developer.paypal.com -> Apps & Credentials (Sandbox).
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_TIMEOUT_SECONDS=15
PAYMENT_CAPTURE_LEASE_SECONDS=120

# Explicit local opt-in; configuration checks are not provider verification.
SANDBOX_CHECKOUT_ENABLED=false
# Demo prices are owned by app/services/demo_catalog.py. Synthetic test
# authorities remain separate under tests/.

# Where PayPal sends the buyer back after approving / cancelling checkout.
# These point at the frontend; the frontend then calls the backend to verify.
PAYPAL_RETURN_URL=http://127.0.0.1:5174/payment/return
PAYPAL_CANCEL_URL=http://127.0.0.1:5174/payment/cancel

# Payment business rules enforced by the backend (comma-separated ISO 4217 codes)
PAYMENT_ALLOWED_CURRENCIES=USD
PAYMENT_MAX_AMOUNT=10000.00

# Persistence. SQLite file for local development (gitignored).
# Deployment: postgresql+asyncpg://user:password@host:5432/rescuepay
# Leave DATABASE_URL unset to use backend/rescuepay.db.
# DATABASE_URL=sqlite+aiosqlite:///./.local/sandbox-checkout-demo.db
DATABASE_ECHO=false
# Local convenience only: create tables from models at startup instead of
# running `alembic upgrade head`. Keep false anywhere migrations are used.
DATABASE_AUTO_CREATE=false

# Default-off local stored-evidence projection; development + loopback only.
# No model provider is configured. Never expose these unauthenticated routes.
LOCAL_EVIDENCE_ENABLED=false
LOCAL_EVIDENCE_TOKEN=
LOCAL_EVIDENCE_USER_ID=demo-merchant

# Read-only Gemini selection adapter. Keep false until a real synthetic smoke
# request is explicitly authorized. Keys are private backend configuration.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=5
GEMINI_MAX_RESPONSE_BYTES=16384
